# Copy to .env and fill in ONLY if you use BigQuery mode. Local Demo Mode needs none of this.
# .env is git-ignored. NEVER put a service-account key or password in this file or anywhere in the repo.

GCP_PROJECT_ID=your-gcp-project-id          # the project that will be billed for your queries
GP_BQ_DATASET=growthpulse                   # dbt writes <dataset>_staging / _intermediate / _marts / _ga4
GP_BQ_RAW_DATASET=growthpulse_raw           # synthetic raw tables are loaded here
GP_BQ_LOCATION=US                           # must be US to read the public GA4 sample
GP_BQ_MAX_BYTES_BILLED=10000000000          # safety cap (10 GB) per query; dbt aborts a query that would exceed it
GP_BQ_AUTH_METHOD=oauth                     # oauth (recommended: gcloud login) or service-account

# Only if GP_BQ_AUTH_METHOD=service-account: path to a key file stored OUTSIDE this project folder
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.secrets/growthpulse-sa.json
